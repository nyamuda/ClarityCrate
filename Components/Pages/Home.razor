@page "/"
@inject NavigationManager NavigationManager
@using Clarity_Crate.Data
@using Clarity_Crate.Services
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject SummarizationService SummarizationService





<style>

    .secondary-colored-text {
        color: #EF6C00;
    }
    .icon-color {
        color: #FFAB00;
    }
    
/*About Start*/

/*About End*/
</style>

<!--Feature Section Start-->
<!-- Section Title -->
<div class="container section-title mb-5 mb-lg-0">
    <h2>Files</h2>
    <p>Supported document types</p>
</div><!-- End Section Title -->
<FeatureSection/>
<!--Feature Section End-->
<!-- Tools Section -->
<section id="tools" class="services section" style="margin-top:4rem;">

    <!-- Section Title -->
    <div class="container section-title mb-5" data-aos="fade-up">
        <h2>Tools</h2>
        <p>What we offer</p>
    </div><!-- End Section Title -->

    <div class="container">

        <div class="row gy-4">

            <!-- Tool 1: OCR Text Extraction -->
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                <div class="service-item position-relative">
                    <div class="icon">
                        <i class="fas fa-file-alt" style="color: #fd7e14;"></i>
                    </div>
                    <h3>OCR Text Extraction</h3>
                    <p>Extract text from images and scanned documents with advanced OCR technology.</p>
                </div>
            </div><!-- End Tool Item -->
            <!-- Tool 2: Text Summarization -->
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                <div class="service-item position-relative">
                    <div class="icon">
                        <i class="fas fa-align-left" style="color: #00897B;"></i>
                    </div>
                    <h3>Text Summarization</h3>
                    <p>Generate concise summaries using paragraph mode, bullet points, or custom formats.</p>
                </div>
            </div><!-- End Tool Item -->
            <!-- Tool 3: Rich Text Editor -->
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="300">
                <div class="service-item position-relative">
                    <div class="icon">
                        <i class="fas fa-edit" style="color: #FFA726;"></i>
                    </div>
                    <h3>Rich Text Editor</h3>
                    <p>Edit and refine content with a feature-rich text editor for better customization.</p>
                </div>
            </div><!-- End Tool Item -->
            <!-- Tool 4: File Conversion -->
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="400">
                <div class="service-item position-relative">
                    <div class="icon">
                        <i class="fas fa-exchange-alt" style="color: #26A69A;"></i>
                    </div>
                    <h3>File Conversion</h3>
                    <p>Easily convert JPEG, PNG, Word, Excel, and PowerPoint files to PDF.</p>
                </div>
            </div><!-- End Tool Item -->
            <!-- Tool 5: Export Options -->
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="500">
                <div class="service-item position-relative">
                    <div class="icon">
                        <i class="fas fa-download" style="color: #fd7e14;"></i>
                    </div>
                    <h3>Export Options</h3>
                    <p>Export your work as a PDF, Word document, or copy it to your clipboard.</p>
                </div>
            </div><!-- End Tool Item -->
            <!-- Tool 6: PDF Viewer -->
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="600">
                <div class="service-item position-relative">
                    <div class="icon">
                        <i class="fas fa-file-pdf" style="color: #00897B;"></i>
                    </div>
                    <h3>PDF Viewer</h3>
                    <p>View and annotate your converted PDFs with ease using the PDF viewer.</p>
                </div>
            </div><!-- End Tool Item -->


        </div>

    </div>

</section><!-- /Tools Section -->
<!-- FAQ Section -->
<div class="container-fluid text-dark feature pt-5" style="margin-top:6rem;">
    <!-- Start Section Title -->
    <div class="container section-title mb-3">
        <h2>FAQ</h2>
        <p>Learn More</p>
    </div><!-- End Section Title -->
    <div class="container">
        <MudExpansionPanels>

            <!-- Summarization Questions -->

            <MudExpansionPanel>
                <TitleContent>
                    <MudText Class="fw-bold">What is the maximum file size for uploads?</MudText>
                </TitleContent>
                <ChildContent>
                    Since currently the app runs on a free server, the maximum upload size for non-scanned PDFs is 5MB. For other file types such as Excel, images, DOCX, and scanned documents, the file size limit is 1MB.
                </ChildContent>
            </MudExpansionPanel>
            <MudExpansionPanel>
                <TitleContent>
                    <MudText Class="fw-bold">What types of documents can be summarized?</MudText>
                </TitleContent>
                <ChildContent>
                    We support summarizing a wide range of documents, including PDFs (both native and scanned using OCR), Word documents (DOC, DOCX), Excel files (XLS, XLSX), PowerPoint presentations (PPT, PPTX), plain text files, images (using OCR), and web content.
                </ChildContent>
            </MudExpansionPanel>

            <MudExpansionPanel>
                <TitleContent>
                    <MudText Class="fw-bold">Is there a limit on the number of documents I can upload?</MudText>
                </TitleContent>
                <ChildContent>
                    There is no strict limit on the number of documents you can upload. However, the app processes one document at a time.
                </ChildContent>
            </MudExpansionPanel>

            

            <!-- OCR and Text Extraction Questions -->
            <MudExpansionPanel>
                <TitleContent>
                    <MudText Class="fw-bold">Does the app support text extraction from images?</MudText>
                </TitleContent>
                <ChildContent>
                    Yes, the app uses advanced OCR technology powered by Tesseract 5 to extract text from images and scanned documents.
                </ChildContent>
            </MudExpansionPanel>

            <MudExpansionPanel>
                <TitleContent>
                    <MudText Class="fw-bold">Can I edit the extracted text before exporting it?</MudText>
                </TitleContent>
                <ChildContent>
                    Absolutely! After extraction, the text can be edited directly in the built-in rich text editor before exporting.
                </ChildContent>
            </MudExpansionPanel>

            <!-- File Conversion Questions -->
            <MudExpansionPanel>
                <TitleContent>
                    <MudText Class="fw-bold">What file conversion options are available?</MudText>
                </TitleContent>
                <ChildContent>
                    The app supports converting Word, Excel, PowerPoint, and image files to PDF, as well as exporting edited content as Word or PDF documents.
                </ChildContent>
            </MudExpansionPanel>

            <MudExpansionPanel>
                <TitleContent>
                    <MudText Class="fw-bold">Can I convert multiple files at once?</MudText>
                </TitleContent>
                <ChildContent>
                    Currently, the app processes one file at a time. Batch conversion is planned for future updates.
                </ChildContent>
            </MudExpansionPanel>

            <!-- Performance and Usage Questions -->
            <MudExpansionPanel>
                <TitleContent>
                    <MudText Class="fw-bold">How long does it take to process a document?</MudText>
                </TitleContent>
                <ChildContent>
                    The first run may take 10-15 seconds due to server initialization. Subsequent tasks are faster, taking around 2-8 seconds.
                </ChildContent>
            </MudExpansionPanel>

            <MudExpansionPanel>
                <TitleContent>
                    <MudText Class="fw-bold">Is my data secure?</MudText>
                </TitleContent>
                <ChildContent>
                    Yes, we prioritize your privacy and do not store your files or data beyond the active session.
                </ChildContent>
            </MudExpansionPanel>

            <!-- Future Feature Questions -->
            <!-- Future Feature Questions -->
            <MudExpansionPanel>
                <TitleContent>
                    <MudText Class="fw-bold">Are there any upcoming features?</MudText>
                </TitleContent>
                <ChildContent>
                    Yes, we're working on improving the summarization feature for better results, increasing the maximum file upload size, and audio transcription to convert speech into text. If there's something you'd like us to add, feel free to reach out.
                </ChildContent>
            </MudExpansionPanel>

        </MudExpansionPanels>

    </div>
</div>
<!-- /FAQ Section -->
